<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoSolar - Plataforma de Simulación Energética y Fotovoltaica</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        solar: {
                            50: '#fffbe1',
                            100: '#fff5b7',
                            400: '#facc15',
                            500: '#eab308',
                            600: '#ca8a04',
                        },
                        eco: {
                            400: '#34d399',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
        input[type=range] { accent-color: #10b981; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased">

    <!-- TOP NAVIGATION HEADER -->
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-gradient-to-tr from-solar-500 to-eco-500 rounded-xl shadow-lg shadow-eco-500/20 text-slate-950">
                    <i data-lucide="sun" class="w-6 h-6 stroke-[2.5]"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-tight text-white flex items-center gap-2">
                        EcoSolar <span class="text-xs font-normal px-2 py-0.5 rounded-full bg-eco-500/10 text-eco-400 border border-eco-500/20">v2.5 Pro</span>
                    </h1>
                    <p class="text-xs text-slate-400">Simulador de Ingeniería Fotovoltaica & Gestión Energética</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div id="statusBadge" class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span id="statusText">Sistema Autosuficiente</span>
                </div>
                <button onclick="openReportModal()" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-solar-500 to-eco-500 hover:opacity-90 text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-md shadow-eco-500/20 transition-all">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    <span>Generar e Integrar Informe</span>
                </button>
                <button onclick="resetToDefaults()" class="text-xs text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-800 hover:bg-slate-800">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                    <span class="hidden sm:inline">Restablecer</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- KPI SUMMARY CARDS (4-GRID) -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-4 shadow-xl">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-xs font-medium uppercase tracking-wider">Producción Solar</span>
                    <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400"><i data-lucide="zap" class="w-4 h-4"></i></div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span id="kpiProduction" class="text-2xl sm:text-3xl font-bold text-white tracking-tight">0.00</span>
                    <span class="text-xs font-semibold text-slate-400">kWh/día</span>
                </div>
                <p class="text-xs text-slate-500 mt-2 flex items-center gap-1">
                    <i data-lucide="trending-up" class="w-3 h-3 text-amber-400"></i>
                    <span id="kpiPeakPower">0.00 kWp pico estimado</span>
                </p>
            </div>

            <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-4 shadow-xl">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-xs font-medium uppercase tracking-wider">Consumo Total</span>
                    <div class="p-2 rounded-lg bg-sky-500/10 text-sky-400"><i data-lucide="home" class="w-4 h-4"></i></div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span id="kpiConsumption" class="text-2xl sm:text-3xl font-bold text-white tracking-tight">0.00</span>
                    <span class="text-xs font-semibold text-slate-400">kWh/día</span>
                </div>
                <p class="text-xs text-slate-500 mt-2 flex items-center gap-1">
                    <i data-lucide="cpu" class="w-3 h-3 text-sky-400"></i>
                    <span id="kpiActiveAppliances">0 electrodomésticos activos</span>
                </p>
            </div>

            <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-4 shadow-xl">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-xs font-medium uppercase tracking-wider">Autosuficiencia</span>
                    <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400"><i data-lucide="pie-chart" class="w-4 h-4"></i></div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span id="kpiAutonomy" class="text-2xl sm:text-3xl font-bold text-white tracking-tight">0%</span>
                    <span id="kpiBalanceBadge" class="text-xs font-semibold px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300">100% Cobertura</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
                    <div id="kpiAutonomyBar" class="bg-emerald-500 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-4 shadow-xl">
                <div class="flex items-center justify-between text-slate-400 mb-2">
                    <span class="text-xs font-medium uppercase tracking-wider">Ahorro CO2</span>
                    <div class="p-2 rounded-lg bg-teal-500/10 text-teal-400"><i data-lucide="leaf" class="w-4 h-4"></i></div>
                </div>
                <div class="flex items-baseline gap-2">
                    <span id="kpiCo2" class="text-2xl sm:text-3xl font-bold text-white tracking-tight">0.0</span>
                    <span class="text-xs font-semibold text-slate-400">kg/mes</span>
                </div>
                <p class="text-xs text-slate-500 mt-2 flex items-center gap-1">
                    <i data-lucide="trees" class="w-3 h-3 text-teal-400"></i>
                    <span id="kpiTrees">Equivale a ~0 árboles plantados</span>
                </p>
            </div>
        </section>

        <!-- GRID SECTION: SOLAR SIMULATOR & APPLIANCES -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- LEFT COLUMN: CONTROLS & ADVANCED CANVAS SIMULATOR (SPAN 7) -->
            <section class="lg:col-span-7 space-y-6">
                <!-- CONTROLS -->
                <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-5 shadow-xl">
                    <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
                        <h2 class="font-semibold text-slate-100 flex items-center gap-2">
                            <i data-lucide="sliders" class="w-5 h-5 text-solar-400"></i>
                            Parámetros del Sistema Fotovoltaico
                        </h2>
                        <span class="text-xs text-slate-400 bg-slate-800 px-2.5 py-1 rounded-lg">Ajuste en tiempo real</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <label for="inputIrradiance" class="text-slate-300 font-medium">Irradiancia Solar</label>
                                <span class="text-amber-400 font-bold"><span id="valIrradiance">800</span> W/m²</span>
                            </div>
                            <input type="range" id="inputIrradiance" min="100" max="1200" step="20" value="800" class="w-full h-2 bg-slate-800 rounded-lg cursor-pointer">
                        </div>

                        <div class="space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <label for="inputArea" class="text-slate-300 font-medium">Área de Paneles</label>
                                <span class="text-amber-400 font-bold"><span id="valArea">20</span> m²</span>
                            </div>
                            <input type="range" id="inputArea" min="1" max="100" step="1" value="20" class="w-full h-2 bg-slate-800 rounded-lg cursor-pointer">
                        </div>

                        <div class="space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <label for="inputEfficiency" class="text-slate-300 font-medium">Eficiencia Módulo</label>
                                <span class="text-amber-400 font-bold"><span id="valEfficiency">20</span>%</span>
                            </div>
                            <input type="range" id="inputEfficiency" min="10" max="26" step="0.5" value="20" class="w-full h-2 bg-slate-800 rounded-lg cursor-pointer">
                        </div>

                        <div class="space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <label for="inputTemp" class="text-slate-300 font-medium">Temperatura Ambiente</label>
                                <span class="text-amber-400 font-bold"><span id="valTemp">28</span> °C</span>
                            </div>
                            <input type="range" id="inputTemp" min="10" max="50" step="1" value="28" class="w-full h-2 bg-slate-800 rounded-lg cursor-pointer">
                        </div>

                        <div class="sm:col-span-2 space-y-1.5">
                            <div class="flex justify-between text-xs">
                                <label for="inputTilt" class="text-slate-300 font-medium">Ángulo de Inclinación (Rota el panel)</label>
                                <span class="text-amber-400 font-bold"><span id="valTilt">25</span>°</span>
                            </div>
                            <input type="range" id="inputTilt" min="0" max="60" step="1" value="25" class="w-full h-2 bg-slate-800 rounded-lg cursor-pointer">
                        </div>
                    </div>
                </div>

                <!-- ADVANCED CANVAS SIMULATION -->
                <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-4 shadow-xl relative overflow-hidden">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-sm font-semibold text-slate-200 flex items-center gap-2">
                            <i data-lucide="activity" class="w-4 h-4 text-emerald-400"></i>
                            Simulador Interactivo de Captación y Flujo Electrónico
                        </h3>
                        <span class="text-[11px] text-emerald-400 font-mono flex items-center gap-1.5 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                            Motor Gráfico Activo
                        </span>
                    </div>

                    <div class="w-full h-64 sm:h-72 bg-slate-950 rounded-xl overflow-hidden border border-slate-800 relative shadow-inner">
                        <canvas id="solarCanvas" class="w-full h-full block"></canvas>
                        
                        <div class="absolute bottom-3 left-3 bg-slate-900/90 backdrop-blur border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-slate-300 pointer-events-none">
                            <div class="text-[10px] uppercase text-slate-500 font-bold">Generación Instantánea</div>
                            <div class="font-bold text-amber-400 text-sm" id="canvasPowerReadout">0.00 kW</div>
                        </div>

                        <div class="absolute bottom-3 right-3 bg-slate-900/90 backdrop-blur border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-slate-300 pointer-events-none text-right">
                            <div class="text-[10px] uppercase text-slate-500 font-bold">Inversor Central</div>
                            <div class="font-bold text-emerald-400 text-xs flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Conversión Activa
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HOURLY CHART -->
                <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-5 shadow-xl">
                    <h3 class="text-sm font-semibold text-slate-100 flex items-center gap-2 mb-4">
                        <i data-lucide="sun-medium" class="w-4 h-4 text-solar-400"></i> Curva de Generación Solar Estimada
                    </h3>
                    <div class="h-60 w-full">
                        <canvas id="solarHourlyChart"></canvas>
                    </div>
                </div>
            </section>

            <!-- RIGHT COLUMN: APPLIANCE MANAGER & CONSUMPTION (SPAN 5) -->
            <section class="lg:col-span-5 space-y-6">
                <div class="bg-slate-900 border border-slate-800/80 rounded-2xl p-5 shadow-xl flex flex-col h-full">
                    <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
                        <div>
                            <h2 class="font-semibold text-slate-100 flex items-center gap-2">
                                <i data-lucide="plug" class="w-5 h-5 text-sky-400"></i> Gestión de Cargas Domésticas
                            </h2>
                            <p class="text-xs text-slate-400">Activa, edita o elimina electrodomésticos</p>
                        </div>
                        <button onclick="openCustomModal()" class="px-2.5 py-1.5 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 text-xs font-medium flex items-center gap-1.5">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Agregar
                        </button>
                    </div>

                    <div class="mb-4 p-3 bg-slate-950/70 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
                        <span class="text-slate-300">Tarifa Eléctrica por kWh:</span>
                        <div class="flex items-center gap-1">
                            <span class="text-slate-500">$</span>
                            <input type="number" id="inputTariff" value="0.18" step="0.01" min="0.01" class="w-20 bg-slate-900 border border-slate-700 rounded px-2 py-1 text-right text-white font-bold">
                        </div>
                    </div>

                    <!-- Appliances List Container with Delete Feature -->
                    <div id="appliancesList" class="space-y-3 max-h-[380px] overflow-y-auto pr-1"></div>

                    <div class="mt-6 pt-4 border-t border-slate-800">
                        <h4 class="text-xs font-semibold text-slate-300 mb-3 flex items-center gap-2">
                            <i data-lucide="pie-chart" class="w-3.5 h-3.5 text-sky-400"></i> Distribución de Consumo Diario
                        </h4>
                        <div class="h-48 w-full">
                            <canvas id="consumptionChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- BOTTOM SECTION: ROI ANALYZER -->
        <section class="bg-slate-900 border border-slate-800/80 rounded-2xl p-6 shadow-xl space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-800 pb-4 gap-2">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <i data-lucide="line-chart" class="w-5 h-5 text-emerald-400"></i> Análisis Financiero y Retorno de Inversión (ROI)
                    </h2>
                </div>
                <div class="flex items-center gap-2 text-xs">
                    <span class="text-slate-400">Costo de Instalación Fotovoltaica:</span>
                    <div class="flex items-center gap-1 bg-slate-950 border border-slate-800 px-3 py-1.5 rounded-lg">
                        <span class="text-slate-500">$</span>
                        <input type="number" id="inputSystemCostM2" value="160" min="50" step="10" class="w-16 bg-transparent text-right font-bold text-emerald-400">
                        <span class="text-slate-400 text-[11px]">/m²</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800">
                    <span class="text-xs text-slate-400 block mb-1">Costo Total Sistema</span>
                    <span id="roiTotalCost" class="text-xl font-bold text-white">$0.00</span>
                </div>
                <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800">
                    <span class="text-xs text-slate-400 block mb-1">Ahorro Mensual Estimado</span>
                    <span id="roiMonthlySavings" class="text-xl font-bold text-emerald-400">$0.00</span>
                </div>
                <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800">
                    <span class="text-xs text-slate-400 block mb-1">Tiempo de Amortización (ROI)</span>
                    <span id="roiPaybackYears" class="text-xl font-bold text-amber-400">0.0 Años</span>
                </div>
                <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800">
                    <span class="text-xs text-slate-400 block mb-1">Beneficio Neto a 25 Años</span>
                    <span id="roi25YearProfit" class="text-xl font-bold text-sky-400">$0.00</span>
                </div>
            </div>

            <div class="h-52 w-full">
                <canvas id="balanceComparisonChart"></canvas>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="border-t border-slate-800 bg-slate-950 py-6 text-center text-xs text-slate-500 mt-8">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3">
            <p>© 2026 EcoSolar Engineering Suite. Todos los derechos reservados.</p>
            <p class="text-slate-600">Simulación Fotovoltaica & Integración de Datos</p>
        </div>
    </footer>

    <!-- REPORT MODAL -->
    <div id="reportModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-lg shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="text-base font-semibold text-white flex items-center gap-2">
                    <i data-lucide="send" class="w-5 h-5 text-emerald-400"></i> Generar e Integrar Informe Técnico
                </h3>
                <button onclick="closeReportModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>

            <form id="reportForm" onsubmit="sendReportToAppScript(event)" class="space-y-4">
                <div>
                    <label class="block text-xs text-slate-300 font-medium mb-1">Nombre del Cliente / Proyecto *</label>
                    <input type="text" id="reportClientName" required placeholder="Ej. Residencia 1" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                </div>

                <div>
                    <label class="block text-xs text-slate-300 font-medium mb-1">Correo Electrónico de Destino *</label>
                    <input type="email" id="reportEmail" required placeholder="cliente@correo.com" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-slate-300 font-medium mb-1">Ubicación / Ciudad</label>
                        <input type="text" id="reportLocation" placeholder="Ej. Riohacha, La Guajira" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-300 font-medium mb-1">Observaciones</label>
                        <input type="text" id="reportNotes" placeholder="Notas adicionales..." class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                    </div>
                </div>

                <div>
                    <label class="block text-xs text-slate-300 font-medium mb-1">URL de Google Apps Script Web App</label>
                    <input type="url" id="scriptUrlInput" required placeholder="https://script.google.com/macros/s/..." class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-amber-400 font-mono text-[11px]">
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t border-slate-800 text-xs">
                    <button type="button" onclick="closeReportModal()" class="px-4 py-2 rounded-lg border border-slate-800 text-slate-300">Cancelar</button>
                    <button type="submit" id="submitReportBtn" class="px-5 py-2 rounded-lg bg-gradient-to-r from-solar-500 to-eco-500 text-slate-950 font-bold">Enviar e Integrar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- CUSTOM APPLIANCE MODAL -->
    <div id="customModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 w-full max-w-md shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="text-base font-semibold text-white">Agregar Electrodoméstico</h3>
                <button onclick="closeCustomModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <form id="addApplianceForm" onsubmit="handleAddAppliance(event)" class="space-y-4">
                <div>
                    <label class="block text-xs text-slate-300 font-medium mb-1">Nombre</label>
                    <input type="text" id="newAppName" required placeholder="Ej. Bomba de Agua" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-slate-300 font-medium mb-1">Potencia (W)</label>
                        <input type="number" id="newAppPower" required min="1" placeholder="1000" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-300 font-medium mb-1">Horas Uso / Día</label>
                        <input type="number" id="newAppHours" required min="0.1" max="24" step="0.5" placeholder="4" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                    </div>
                </div>
                <div>
                    <label class="block text-xs text-slate-300 font-medium mb-1">Categoría</label>
                    <select id="newAppCategory" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-white">
                        <option value="Climatización">Climatización</option>
                        <option value="Refrigeración">Refrigeración</option>
                        <option value="Cocina">Cocina</option>
                        <option value="Entretenimiento">Entretenimiento</option>
                        <option value="Iluminación">Iluminación</option>
                        <option value="Otros">Otros</option>
                    </select>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeCustomModal()" class="px-4 py-2 rounded-lg text-xs border border-slate-800 text-slate-300">Cancelar</button>
                    <button type="submit" class="px-4 py-2 rounded-lg text-xs bg-sky-500 text-slate-950 font-bold">Guardar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JAVASCRIPT APPLICATION LOGIC -->
    <script>
        const defaultAppliances = [
            { id: '1', name: 'Aire Acondicionado Inverter', power: 1200, hours: 6, active: true, category: 'Climatización' },
            { id: '2', name: 'Refrigerador No-Frost', power: 180, hours: 24, active: true, category: 'Refrigeración' },
            { id: '3', name: 'Iluminación LED (10 Bombillos)', power: 100, hours: 5, active: true, category: 'Iluminación' },
            { id: '4', name: 'Workstation / Computador', power: 250, hours: 8, active: true, category: 'Entretenimiento' },
            { id: '5', name: 'Smart TV 55"', power: 120, hours: 5, active: true, category: 'Entretenimiento' }
        ];

        let appliances = JSON.parse(JSON.stringify(defaultAppliances));
        let hourlyChart = null;
        let consumptionChart = null;
        let comparisonChart = null;

        function calculateSolarMetrics() {
            const G = parseFloat(document.getElementById('inputIrradiance').value);
            const area = parseFloat(document.getElementById('inputArea').value);
            const eff = parseFloat(document.getElementById('inputEfficiency').value) / 100;
            const temp = parseFloat(document.getElementById('inputTemp').value);
            const tilt = parseFloat(document.getElementById('inputTilt').value);

            const tempLossFactor = 1 - Math.max(0, (temp - 25) * 0.004);
            const tiltRad = (tilt - 22) * Math.PI / 180;
            const tiltFactor = Math.max(0.6, Math.cos(tiltRad));

            const peakPowerKW = (area * 1000 * eff * tempLossFactor * tiltFactor) / 1000;

            const hourlyData = [];
            const hoursLabels = [];
            let dailyTotalKWh = 0;

            for (let h = 6; h <= 18; h++) {
                hoursLabels.push(`${h}:00`);
                const hourAngle = ((h - 6) / 12) * Math.PI;
                const instantRatio = Math.max(0, Math.sin(hourAngle));
                const hourKW = peakPowerKW * (G / 1000) * instantRatio;
                hourlyData.push(parseFloat(hourKW.toFixed(2)));
                dailyTotalKWh += hourKW;
            }

            return {
                G, area, eff, temp, tilt,
                peakPowerKW: parseFloat(peakPowerKW.toFixed(2)),
                dailyTotalKWh: parseFloat(dailyTotalKWh.toFixed(2)),
                hourlyData,
                hoursLabels
            };
        }

        function calculateConsumptionMetrics() {
            let totalDailyKWh = 0;
            let activeCount = 0;
            const categoryTotals = {};

            appliances.forEach(app => {
                if (app.active) {
                    activeCount++;
                    const dailyKWh = (app.power * app.hours) / 1000;
                    totalDailyKWh += dailyKWh;
                    categoryTotals[app.category] = (categoryTotals[app.category] || 0) + dailyKWh;
                }
            });

            return {
                totalDailyKWh: parseFloat(totalDailyKWh.toFixed(2)),
                activeCount,
                categoryTotals
            };
        }

        function updateUI() {
            const solar = calculateSolarMetrics();
            const cons = calculateConsumptionMetrics();
            const tariff = parseFloat(document.getElementById('inputTariff').value) || 0.18;
            const costPerM2 = parseFloat(document.getElementById('inputSystemCostM2').value) || 160;

            document.getElementById('valIrradiance').textContent = solar.G;
            document.getElementById('valArea').textContent = solar.area;
            document.getElementById('valEfficiency').textContent = solar.eff * 100;
            document.getElementById('valTemp').textContent = solar.temp;
            document.getElementById('valTilt').textContent = solar.tilt;

            document.getElementById('kpiProduction').textContent = solar.dailyTotalKWh.toFixed(2);
            document.getElementById('kpiPeakPower').textContent = `${solar.peakPowerKW} kWp pico estimado`;

            document.getElementById('kpiConsumption').textContent = cons.totalDailyKWh.toFixed(2);
            document.getElementById('kpiActiveAppliances').textContent = `${cons.activeCount} de ${appliances.length} activos`;

            const autonomy = cons.totalDailyKWh > 0 
                ? Math.min(100, Math.round((solar.dailyTotalKWh / cons.totalDailyKWh) * 100))
                : 100;

            document.getElementById('kpiAutonomy').textContent = `${autonomy}%`;
            document.getElementById('kpiAutonomyBar').style.width = `${autonomy}%`;

            const statusBadge = document.getElementById('statusBadge');
            const statusText = document.getElementById('statusText');
            const balanceBadge = document.getElementById('kpiBalanceBadge');

            if (solar.dailyTotalKWh >= cons.totalDailyKWh) {
                statusBadge.className = "hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30";
                statusText.textContent = "Sistema Autosuficiente";
                balanceBadge.textContent = "100% Cobertura";
                balanceBadge.className = "text-xs font-semibold px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300";
            } else {
                statusBadge.className = "hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/30";
                statusText.textContent = "Dependiente de Red";
                balanceBadge.textContent = `${autonomy}% Cobertura`;
                balanceBadge.className = "text-xs font-semibold px-2 py-0.5 rounded-md bg-amber-500/20 text-amber-300";
            }

            const monthlyGen = solar.dailyTotalKWh * 30;
            const co2Saved = (monthlyGen * 0.42).toFixed(1);
            document.getElementById('kpiCo2').textContent = co2Saved;
            document.getElementById('kpiTrees').textContent = `Equivale a ~${Math.round(co2Saved / 1.8)} árboles plantados/mes`;

            document.getElementById('canvasPowerReadout').textContent = `${(solar.peakPowerKW * (solar.G / 1000)).toFixed(2)} kW`;

            const totalSystemCost = solar.area * costPerM2;
            const coveredDailyKWh = Math.min(solar.dailyTotalKWh, cons.totalDailyKWh);
            const surplusDailyKWh = Math.max(0, solar.dailyTotalKWh - cons.totalDailyKWh);

            const monthlySavings = (coveredDailyKWh * 30 * tariff) + (surplusDailyKWh * 30 * tariff * 0.5);
            const annualSavings = monthlySavings * 12;
            const paybackYears = annualSavings > 0 ? (totalSystemCost / annualSavings) : 0;
            const profit25Years = (annualSavings * 25) - totalSystemCost;

            document.getElementById('roiTotalCost').textContent = `$${totalSystemCost.toLocaleString('en-US', {maximumFractionDigits:0})}`;
            document.getElementById('roiMonthlySavings').textContent = `$${monthlySavings.toFixed(2)} /mes`;
            document.getElementById('roiPaybackYears').textContent = paybackYears > 0 ? `${paybackYears.toFixed(1)} Años` : 'N/A';
            document.getElementById('roi25YearProfit').textContent = `$${Math.max(0, profit25Years).toLocaleString('en-US', {maximumFractionDigits:0})}`;

            renderHourlyChart(solar.hoursLabels, solar.hourlyData);
            renderConsumptionChart(cons.categoryTotals);
            renderComparisonChart(solar.dailyTotalKWh, cons.totalDailyKWh);
        }

        function renderHourlyChart(labels, data) {
            if (!hourlyChart) {
                const ctx = document.getElementById('solarHourlyChart').getContext('2d');
                hourlyChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Potencia Generada (kW)',
                            data: data,
                            borderColor: '#facc15',
                            backgroundColor: 'rgba(250, 204, 21, 0.15)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#eab308'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' } },
                            y: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' }, beginAtZero: true }
                        }
                    }
                });
            } else {
                hourlyChart.data.labels = labels;
                hourlyChart.data.datasets[0].data = data;
                hourlyChart.update();
            }
        }

        function renderConsumptionChart(categoryTotals) {
            const labels = Object.keys(categoryTotals);
            const data = Object.values(categoryTotals);
            const colors = ['#38bdf8', '#34d399', '#facc15', '#a78bfa', '#f472b6', '#fb923c'];

            if (!consumptionChart) {
                const ctx = document.getElementById('consumptionChart').getContext('2d');
                consumptionChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels.length ? labels : ['Sin Cargas'],
                        datasets: [{
                            data: data.length ? data : [1],
                            backgroundColor: colors,
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { color: '#94a3b8', font: { size: 10 } } } },
                        cutout: '70%'
                    }
                });
            } else {
                consumptionChart.data.labels = labels.length ? labels : ['Sin Cargas'];
                consumptionChart.data.datasets[0].data = data.length ? data : [1];
                consumptionChart.update();
            }
        }

        function renderComparisonChart(solarKWh, consKWh) {
            if (!comparisonChart) {
                const ctx = document.getElementById('balanceComparisonChart').getContext('2d');
                comparisonChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Energía Diaria (kWh)'],
                        datasets: [
                            { label: 'Generación Solar', data: [solarKWh], backgroundColor: '#10b981', borderRadius: 8 },
                            { label: 'Consumo Doméstico', data: [consKWh], backgroundColor: '#38bdf8', borderRadius: 8 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: { legend: { labels: { color: '#94a3b8' } } },
                        scales: {
                            x: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' }, beginAtZero: true },
                            y: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                        }
                    }
                });
            } else {
                comparisonChart.data.datasets[0].data = [solarKWh];
                comparisonChart.data.datasets[1].data = [consKWh];
                comparisonChart.update();
            }
        }

        function renderAppliancesList() {
            const container = document.getElementById('appliancesList');
            container.innerHTML = '';

            appliances.forEach((app, idx) => {
                const item = document.createElement('div');
                item.className = `p-3 rounded-xl border transition-all ${app.active ? 'bg-slate-900 border-slate-700/80' : 'bg-slate-950/40 border-slate-800/50 opacity-60'}`;
                item.innerHTML = `
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-2.5">
                            <input type="checkbox" ${app.active ? 'checked' : ''} onchange="toggleAppliance(${idx})" class="w-4 h-4 rounded text-eco-500 bg-slate-950 border-slate-700 cursor-pointer">
                            <div>
                                <h4 class="text-xs font-semibold text-white leading-none">${app.name}</h4>
                                <span class="text-[10px] text-slate-400">${app.category}</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <span class="text-xs font-bold text-sky-400">${((app.power * app.hours) / 1000).toFixed(2)} kWh</span>
                                <span class="text-[10px] text-slate-500 block">/día</span>
                            </div>
                            <button onclick="deleteAppliance(${idx})" class="text-slate-500 hover:text-red-400 transition-colors p-1.5 rounded-lg hover:bg-slate-800" title="Eliminar equipo">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(item);
            });
            lucide.createIcons();
        }

        function toggleAppliance(index) {
            appliances[index].active = !appliances[index].active;
            renderAppliancesList();
            updateUI();
        }

        function deleteAppliance(index) {
            appliances.splice(index, 1);
            renderAppliancesList();
            updateUI();
        }

        function openCustomModal() { document.getElementById('customModal').classList.remove('hidden'); }
        function closeCustomModal() { document.getElementById('customModal').classList.add('hidden'); }
        
        function openReportModal() { 
            const savedUrl = localStorage.getItem('ecoSolarScriptUrl') || '';
            if (savedUrl) document.getElementById('scriptUrlInput').value = savedUrl;
            document.getElementById('reportModal').classList.remove('hidden'); 
        }
        function closeReportModal() { document.getElementById('reportModal').classList.add('hidden'); }

        function handleAddAppliance(e) {
            e.preventDefault();
            appliances.push({
                id: Date.now().toString(),
                name: document.getElementById('newAppName').value,
                power: parseFloat(document.getElementById('newAppPower').value),
                hours: parseFloat(document.getElementById('newAppHours').value),
                active: true,
                category: document.getElementById('newAppCategory').value
            });
            document.getElementById('addApplianceForm').reset();
            closeCustomModal();
            renderAppliancesList();
            updateUI();
        }

        async function sendReportToAppScript(event) {
            event.preventDefault();
            const endpoint = document.getElementById('scriptUrlInput').value.trim();
            if (!endpoint) {
                alert('Por favor ingresa la URL de tu Google Apps Script');
                return;
            }
            localStorage.setItem('ecoSolarScriptUrl', endpoint);

            const clientName = document.getElementById('reportClientName').value;
            const email = document.getElementById('reportEmail').value;
            const location = document.getElementById('reportLocation').value;
            const notes = document.getElementById('reportNotes').value;

            const solar = calculateSolarMetrics();
            const cons = calculateConsumptionMetrics();
            const tariff = parseFloat(document.getElementById('inputTariff').value) || 0.18;
            const costPerM2 = parseFloat(document.getElementById('inputSystemCostM2').value) || 160;

            const totalSystemCost = solar.area * costPerM2;
            const coveredDailyKWh = Math.min(solar.dailyTotalKWh, cons.totalDailyKWh);
            const surplusDailyKWh = Math.max(0, solar.dailyTotalKWh - cons.totalDailyKWh);
            const monthlySavings = (coveredDailyKWh * 30 * tariff) + (surplusDailyKWh * 30 * tariff * 0.5);
            const annualSavings = monthlySavings * 12;
            const paybackYears = annualSavings > 0 ? (totalSystemCost / annualSavings) : 0;
            const monthlyGen = solar.dailyTotalKWh * 30;
            const co2Saved = (monthlyGen * 0.42).toFixed(1);
            const autonomy = cons.totalDailyKWh > 0 ? Math.min(100, Math.round((solar.dailyTotalKWh / cons.totalDailyKWh) * 100)) : 100;

            const payload = {
                clientName: clientName,
                email: email,
                location: location,
                notes: notes,
                peakPowerKW: parseFloat(solar.peakPowerKW),
                dailyTotalKWh: parseFloat(solar.dailyTotalKWh),
                dailyConsumptionKWh: parseFloat(cons.totalDailyKWh),
                autonomyPercentage: parseFloat(autonomy),
                totalInvestment: parseFloat(totalSystemCost.toFixed(0)),
                monthlySavings: parseFloat(monthlySavings.toFixed(2)),
                paybackYears: parseFloat(paybackYears.toFixed(1)),
                co2Saved: parseFloat(co2Saved)
            };

            const btn = document.getElementById('submitReportBtn');
            btn.disabled = true;
            btn.innerText = 'Enviando...';

            try {
                await fetch(endpoint, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });

                alert('¡Informe enviado e integrado exitosamente!');
                closeReportModal();
            } catch (err) {
                alert('Error al enviar el informe: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = 'Enviar e Integrar';
            }
        }

        function resetToDefaults() {
            appliances = JSON.parse(JSON.stringify(defaultAppliances));
            document.getElementById('inputIrradiance').value = 800;
            document.getElementById('inputArea').value = 20;
            document.getElementById('inputEfficiency').value = 20;
            document.getElementById('inputTemp').value = 28;
            document.getElementById('inputTilt').value = 25;
            document.getElementById('inputTariff').value = 0.18;
            document.getElementById('inputSystemCostM2').value = 160;
            renderAppliancesList();
            updateUI();
        }

        // ADVANCED CANVAS SIMULATION ENGINE
        let canvas, ctx, particles = [];
        function initCanvas() {
            canvas = document.getElementById('solarCanvas');
            ctx = canvas.getContext('2d');
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            for (let i = 0; i < 40; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * (canvas.height / 2),
                    speed: 1.2 + Math.random() * 2.5,
                    length: 12 + Math.random() * 18,
                    opacity: 0.3 + Math.random() * 0.7
                });
            }
            requestAnimationFrame(drawCanvas);
        }

        function resizeCanvas() {
            if (!canvas) return;
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }

        function drawCanvas() {
            if (!ctx) return;
            const w = canvas.width;
            const h = canvas.height;

            const G = parseFloat(document.getElementById('inputIrradiance').value);
            const tilt = parseFloat(document.getElementById('inputTilt').value);

            // Dynamic sky gradient
            const skyGrad = ctx.createLinearGradient(0, 0, 0, h);
            const brightness = Math.min(120, Math.max(15, G / 10));
            skyGrad.addColorStop(0, `rgb(${15 + brightness * 0.5}, ${23 + brightness * 0.8}, ${42 + brightness})`);
            skyGrad.addColorStop(1, '#020617');
            ctx.fillStyle = skyGrad;
            ctx.fillRect(0, 0, w, h);

            // Realistic Glowing Sun
            const sunX = w * 0.18;
            const sunY = h * 0.28;
            const sunGlow = ctx.createRadialGradient(sunX, sunY, 5, sunX, sunY, 60);
            sunGlow.addColorStop(0, '#fef08a');
            sunGlow.addColorStop(0.4, 'rgba(250, 204, 21, 0.4)');
            sunGlow.addColorStop(1, 'rgba(250, 204, 21, 0)');
            ctx.fillStyle = sunGlow;
            ctx.beginPath();
            ctx.arc(sunX, sunY, 60, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#facc15';
            ctx.beginPath();
            ctx.arc(sunX, sunY, 18, 0, Math.PI * 2);
            ctx.fill();

            // Photons / Solar Rays Streams
            const panelX = w * 0.5;
            const panelY = h * 0.58;

            ctx.lineWidth = 1.5;
            particles.forEach(p => {
                p.y += p.speed * (G / 600);
                p.x += p.speed * 0.7;

                if (p.y > panelY || p.x > w) {
                    p.x = sunX + (Math.random() * 40 - 20);
                    p.y = sunY + (Math.random() * 20 - 10);
                }

                ctx.strokeStyle = `rgba(250, 204, 21, ${p.opacity * (G / 1200)})`;
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(p.x + p.length * 0.6, p.y + p.length);
                ctx.stroke();
            });

            // Physics Tilting Solar Array
            ctx.save();
            ctx.translate(panelX, panelY);
            ctx.rotate((-tilt * Math.PI) / 180 * 0.45);

            // Panel shadow
            ctx.fillStyle = 'rgba(0,0,0,0.5)';
            ctx.fillRect(-85, 20, 170, 10);

            // Panel Frame
            ctx.fillStyle = '#0f172a';
            ctx.strokeStyle = '#38bdf8';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.roundRect(-80, -22, 160, 44, 6);
            ctx.fill();
            ctx.stroke();

            // Silicon Photovoltaic Cells Grid
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.5)';
            ctx.lineWidth = 1;
            for (let i = 1; i < 6; i++) {
                ctx.beginPath();
                ctx.moveTo(-80 + (160 / 6) * i, -22);
                ctx.lineTo(-80 + (160 / 6) * i, 22);
                ctx.stroke();
            }
            ctx.restore();

            // Inverter Box Unit
            const invX = w * 0.74;
            const invY = h * 0.72;
            ctx.fillStyle = '#1e293b';
            ctx.strokeStyle = '#475569';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.roundRect(invX - 22, invY - 26, 44, 52, 6);
            ctx.fill();
            ctx.stroke();

            // Inverter Status LED
            ctx.fillStyle = G > 200 ? '#10b981' : '#f59e0b';
            ctx.beginPath();
            ctx.arc(invX, invY - 12, 3.5, 0, Math.PI * 2);
            ctx.fill();

            // House Building
            const houseX = w * 0.90;
            const houseY = h * 0.72;
            ctx.fillStyle = '#334155';
            ctx.beginPath();
            ctx.moveTo(houseX - 25, houseY - 30);
            ctx.lineTo(houseX, houseY - 50);
            ctx.lineTo(houseX + 25, houseY - 30);
            ctx.lineTo(houseX + 25, houseY + 25);
            ctx.lineTo(houseX - 25, houseY + 25);
            ctx.closePath();
            ctx.fill();

            // House Window with warm glow
            ctx.fillStyle = '#fef08a';
            ctx.beginPath();
            ctx.roundRect(houseX - 10, houseY - 10, 20, 20, 3);
            ctx.fill();

            // Power Transmission Line
            ctx.strokeStyle = '#64748b';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.moveTo(panelX, panelY + 22);
            ctx.lineTo(invX, invY);
            ctx.lineTo(houseX - 25, houseY);
            ctx.stroke();

            // Animated Electronic Pulses (Green Current)
            const time = Date.now() * 0.0035;
            const speedFactor = Math.max(0.3, G / 600);
            ctx.fillStyle = '#34d399';
            for (let e = 0; e < 6; e++) {
                const offset = ((time * speedFactor + e * 0.18) % 1);
                const px = panelX + offset * (houseX - 25 - panelX);
                const py = (panelY + 22) + offset * (houseY - (panelY + 22));
                ctx.beginPath();
                ctx.arc(px, py, 4, 0, Math.PI * 2);
                ctx.fill();
            }

            requestAnimationFrame(drawCanvas);
        }

        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            ['inputIrradiance', 'inputArea', 'inputEfficiency', 'inputTemp', 'inputTilt', 'inputTariff', 'inputSystemCostM2'].forEach(id => {
                document.getElementById(id).addEventListener('input', updateUI);
            });
            renderAppliancesList();
            updateUI();
            initCanvas();
        });
    </script>
</body>
</html>
